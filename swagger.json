  "components": {
    "schemas": {
      "ApprovePolicyDto": {
        "type": "object",
        "properties": {
          "premium": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AssignAgentDto": {
        "required": [
          "agentID",
          "requestID"
        ],
        "type": "object",
        "properties": {
          "requestID": {
            "type": "integer",
            "format": "int32"
          },
          "agentID": {
            "type": "integer",
            "format": "int32"
          },
          "adminRemarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClaimStatus": {
        "enum": [
          1,
          2,
          3,
          4,
          5
        ],
        "type": "integer",
        "format": "int32"
      },
      "CreateClaimDto": {
        "type": "object",
        "properties": {
          "activePolicyId": {
            "type": "integer",
            "format": "int32"
          },
          "claimReason": {
            "type": "string",
            "nullable": true
          },
          "claimAmountRequested": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateInsuranceRequestDto": {
        "type": "object",
        "properties": {
          "requestedCoverageAmount": {
            "type": "number",
            "format": "double"
          },
          "preferredCoverageNotes": {
            "type": "string",
            "nullable": true
          },
          "eventType": {
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "durationInHours": {
            "type": "integer",
            "format": "int32"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "expectedAttendees": {
            "type": "integer",
            "format": "int32"
          },
          "eventBudget": {
            "type": "number",
            "format": "double"
          },
          "isOutdoorVenue": {
            "type": "boolean"
          },
          "hasFireworks": {
            "type": "boolean"
          },
          "hasVipPresence": {
            "type": "boolean"
          },
          "alcoholServed": {
            "type": "boolean"
          },
          "specialNotes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "activePolicyId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          },
          "transactionReference": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePolicyCreationRequestDto": {
        "type": "object",
        "properties": {
          "insuranceRequestId": {
            "type": "integer",
            "format": "int32"
          },
          "requestedProductSummary": {
            "type": "string",
            "nullable": true
          },
          "requiredCoverageDetails": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePolicyProductDto": {
        "type": "object",
        "properties": {
          "productName": {
            "type": "string",
            "nullable": true
          },
          "eventTypeSupported": {
            "type": "string",
            "nullable": true
          },
          "baseRate": {
            "type": "number",
            "format": "double"
          },
          "minCoverageAmount": {
            "type": "number",
            "format": "double"
          },
          "maxCoverageAmount": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreatePolicySuggestionDto": {
        "type": "object",
        "properties": {
          "insuranceRequestId": {
            "type": "integer",
            "format": "int32"
          },
          "policyProductIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "suggestionRemarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReviewClaimDto": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "approvedSettlementAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "officerRemarks": {
